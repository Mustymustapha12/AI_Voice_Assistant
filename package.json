{
  "name": "ai-voice-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise multi-tenant AI voice commerce platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel=3",
    "dev:api": "pnpm --filter @avc/control-api dev",
    "dev:web": "pnpm --filter @avc/admin-web dev",
    "dev:worker": "pnpm --filter @avc/event-worker dev",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test:coverage",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @avc/database prisma:generate",
    "db:migrate": "pnpm --filter @avc/database prisma:migrate",
    "db:reset": "pnpm --filter @avc/database prisma:reset",
    "db:seed": "pnpm --filter @avc/database prisma:seed",
    "db:deploy": "pnpm --filter @avc/database prisma:deploy",
    "db:studio": "pnpm --filter @avc/database prisma:studio",
    "auth:bootstrap-super-admin": "pnpm --filter @avc/identity-access bootstrap:super-admin",
    "qa:auth": "pnpm --filter @avc/database qa:auth",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^15.4.4",
    "@nx/js": "^21.3.5",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nx": "^21.3.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
