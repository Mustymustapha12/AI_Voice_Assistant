{
  "name": "@avc/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prisma:deploy": "dotenv -e ../../../.env -- prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../../.env -- prisma migrate deploy",
    "prisma:migrate:dev": "dotenv -e ../../../.env -- prisma migrate dev",
    "prisma:reset": "dotenv -e ../../../.env -- prisma migrate reset --force --skip-seed && pnpm prisma:seed",
    "prisma:seed": "dotenv -e ../../../.env -- tsx prisma/seed.ts",
    "prisma:studio": "dotenv -e ../../../.env -- prisma studio",
    "qa:auth": "dotenv -e ../../../.env -- tsx prisma/qa-authentication.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
