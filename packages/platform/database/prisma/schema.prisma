generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  EMAIL_UNVERIFIED
  ACCOUNT_DISABLED
  RATE_LIMITED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(320)
  normalizedEmail   String   @unique @map("normalized_email") @db.VarChar(320)
  displayName       String   @map("display_name") @db.VarChar(120)
  passwordHash      String?  @map("password_hash") @db.VarChar(512)
  role              PlatformRole
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int      @default(1)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  loginHistory            LoginHistory[]
  auditRecords             AuditLog[] @relation("AuditActor")

  @@index([role, status])
  @@map("identity_users")
}

model Session {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  tokenHash           String   @map("token_hash") @db.Char(64)
  familyId            String   @map("family_id") @db.Uuid
  replacedBySessionId String?  @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?  @map("ip_address") @db.VarChar(64)
  userAgent           String?  @map("user_agent") @db.VarChar(512)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt          DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason    String?  @map("revocation_reason") @db.VarChar(120)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("identity_sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("identity_email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("identity_password_reset_tokens")
}

model LoginHistory {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  normalizedEmail String     @map("normalized_email") @db.VarChar(320)
  outcome       LoginOutcome
  ipAddress     String?      @map("ip_address") @db.VarChar(64)
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  failureReason String?      @map("failure_reason") @db.VarChar(120)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalizedEmail, occurredAt])
  @@index([userId, occurredAt])
  @@map("identity_login_history")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  action        String       @db.VarChar(160)
  resourceType  String       @map("resource_type") @db.VarChar(100)
  resourceId    String?      @map("resource_id") @db.VarChar(100)
  outcome       AuditOutcome
  correlationId String?      @map("correlation_id") @db.VarChar(128)
  ipAddress     String?      @map("ip_address") @db.VarChar(64)
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  metadata      Json?
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("identity_audit_logs")
}
